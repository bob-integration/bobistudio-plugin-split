{
  "license": "GPL-3.0-or-later",
  "type": "split",
  "runtime": "docker",
  "atem_role": "dve",
  "label": "Split",
  "badge": {
    "label": "Split",
    "class": "mode-split",
    "oklch": "0.80 0.06 200"
  },
  "reference_slot": 4,
  "skaarhoj": {
    "mode": "split",
    "desc_i18n": "settings.js.skh_desc_split"
  },
  "version": "0.7.3",
  "description": "SuperSource : 4 PiP (position/taille/crop) composités sur 1 fond → 1 sortie. Géométrie + mémoires/transitions pilotées en live. (v0.2.0 : marqueur `variant` exposé sur :8080 pour tester le multi-versions.)",
  "nav": {
    "section": "traitements",
    "label": "Traitements",
    "route": "/traitements/split",
    "order": 40
  },
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "deploy_defaults": {
    "width": 1280,
    "height": 720,
    "fps": 25,
    "scan": "p",
    "genlock": true,
    "align_budget": 1,
    "box_config": [
      {
        "x": 0.28,
        "y": 0.3,
        "size": 0.42
      },
      {
        "x": 0.72,
        "y": 0.3,
        "size": 0.42
      },
      {
        "x": 0.28,
        "y": 0.7,
        "size": 0.42
      },
      {
        "x": 0.72,
        "y": 0.7,
        "size": 0.42
      }
    ],
    "input_0": null,
    "input_1": null,
    "input_2": null,
    "input_3": null,
    "bg_input": null
  },
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{hostname}_split"
      }
    ],
    "consumes": [
      {
        "essence": "video",
        "slot": 0,
        "state_field": "input_0",
        "label": "Box 1"
      },
      {
        "essence": "video",
        "slot": 1,
        "state_field": "input_1",
        "label": "Box 2"
      },
      {
        "essence": "video",
        "slot": 2,
        "state_field": "input_2",
        "label": "Box 3"
      },
      {
        "essence": "video",
        "slot": 3,
        "state_field": "input_3",
        "label": "Box 4"
      },
      {
        "essence": "video",
        "slot": 4,
        "state_field": "bg_input",
        "label": "Fond"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/state"
  },
  "control": {
    "port": 8082,
    "endpoints": [
      "/state",
      "/input",
      "/box",
      "/recall"
    ],
    "atem": {
      "CSBP": "/box"
    },
    "recall": {
      "source": "plugin_store",
      "scope": "container",
      "endpoint": "/recall"
    }
  },
  "store": {
    "scope": "container"
  },
  "actions": [
    {
      "id": "recall_memory",
      "label": "Rappeler une mémoire",
      "core": "recall",
      "params": [
        {
          "key": "memory",
          "label": "Mémoire",
          "type": "number",
          "options_from": "recall"
        },
        {
          "key": "duration_ms",
          "label": "Transition (ms, 0 = cut)",
          "type": "number",
          "default": 0
        }
      ]
    }
  ],
  "config_schema": [
    {
      "key": "slice_mode",
      "hidden": true,
      "type": "checkbox",
      "label": "Mode tranche (latence sous-image)",
      "help": "La vidéo est publiée bande par bande sur le bus MXL : l'aval démarre sur la première bande sans attendre l'image complète (latence sous-image). Entrelacé ou hauteur non divisible → repli image entière. Désactivé (défaut) = comportement historique. Le fond et chaque box suivent leur grain source.",
      "default": false,
      "scope": "system"
    },
    {
      "key": "slice_lines",
      "hidden": true,
      "type": "number",
      "label": "Lignes par tranche",
      "help": "Hauteur des bandes (lignes). Doit être un diviseur de la hauteur d'image (36 pour 1080p) — sinon repli image entière.",
      "min": 4,
      "max": 540,
      "default": 36,
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      }
    },
    {
      "key": "cadence",
      "hidden": true,
      "type": "select",
      "label": "Cadence de composition",
      "help": "flow : tissu en tranches — chaque couche cible l'index d'epoch de sa source et la sortie est écrite à ce même index (exige le mode tranche éligible, sinon repli pacing historique).",
      "default": "",
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      },
      "options": [
        {
          "value": "",
          "label": "Pacing historique (défaut)"
        },
        {
          "value": "flow",
          "label": "Flow (tissu en tranches)"
        }
      ]
    }
  ]
}
