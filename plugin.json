{
  "license": "GPL-3.0-or-later",
  "type": "split",
  "runtime": "docker",
  "atem_role": "dve",
  "label": "Split",
  "badge": {
    "label": "Split",
    "class": "mode-split",
    "oklch": "0.80 0.06 200"
  },
  "reference_slot": 4,
  "skaarhoj": {
    "mode": "split",
    "desc_i18n": "settings.js.skh_desc_split"
  },
  "version": "0.24.6",
  "description": "Composite 4 incrustations (PiP) sur un fond → 1 sortie, + couche ART (habillage importé, incrustation luma/chroma/alpha, au-dessus ou en dessous). Mode avancé par box : rotation, opacité, adoucissement des bords, coins arrondis, ombre portée, miroir, ratio libre, z-ordre libre, bordure 3D (biseau + source de lumière). Transitions à courbes d'accélération, décalage inter-boxes, tous les paramètres interpolés. Réglages avancés neutres par défaut → chemin de composition historique inchangé.",
  "nav": { "section": "composition", "label": "Composition", "route": "/composition", "order": 30 },
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "deploy_defaults": {
    "width": 1280,
    "height": 720,
    "fps": 25,
    "scan": "p",
    "render": "cpu",
    "genlock": true,
    "align_budget": 1,
    "box_config": [
      {
        "x": 0.28,
        "y": 0.3,
        "size": 0.42
      },
      {
        "x": 0.72,
        "y": 0.3,
        "size": 0.42
      },
      {
        "x": 0.28,
        "y": 0.7,
        "size": 0.42
      },
      {
        "x": 0.72,
        "y": 0.7,
        "size": 0.42
      }
    ],
    "input_0": null,
    "input_1": null,
    "input_2": null,
    "input_3": null,
    "bg_input": null,
    "light": {
      "angle": 36.0,
      "altitude": 25.0
    },
    "transition": {
      "curve": "ease_in_out",
      "stagger_ms": 0
    },
    "art": {
      "enabled": false,
      "above": true,
      "image": "",
      "key": "alpha",
      "clip": 0.0,
      "gain": 1.0,
      "invert": false,
      "opacity": 1.0,
      "chroma_key": "#00b140"
    },
    "log_level": "info"
  },
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{hostname}_split"
      }
    ],
    "consumes": [
      {
        "essence": "video",
        "slot": 0,
        "state_field": "input_1",
        "label": "Box 1"
      },
      {
        "essence": "video",
        "slot": 1,
        "state_field": "input_2",
        "label": "Box 2"
      },
      {
        "essence": "video",
        "slot": 2,
        "state_field": "input_3",
        "label": "Box 3"
      },
      {
        "essence": "video",
        "slot": 3,
        "state_field": "input_4",
        "label": "Box 4"
      },
      {
        "essence": "video",
        "slot": 4,
        "state_field": "bg_input",
        "label": "Fond"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/state"
  },
  "control": {
    "port": 8082,
    "endpoints": [
      "/state",
      "/input",
      "/box",
      "/recall",
      "/art",
      "/light",
      "/transition",
      "/global",
      "/bg",
      "/latency",
      "/log_level"
    ],
    "atem": {
      "CSBP": "/box"
    },
    "recall": {
      "source": "plugin_store",
      "scope": "container",
      "endpoint": "/recall"
    },
    "read_endpoints": [
      "/state"
    ]
  },
  "store": {
    "scope": "container"
  },
  "actions": [
    {
      "id": "recall_memory",
      "label": "Rappeler une mémoire",
      "core": "recall",
      "params": [
        {
          "key": "memory",
          "label": "Mémoire",
          "type": "number",
          "options_from": "recall"
        },
        {
          "key": "duration_ms",
          "label": "Transition (ms, 0 = cut)",
          "type": "number",
          "default": 0
        }
      ]
    },
    {
      "id": "latency_mode",
      "label": "Délai (à chaud)",
      "endpoint": "/latency",
      "params": [
        {
          "key": "mode",
          "label": "Délai",
          "type": "text",
          "default": "fixed_1",
          "options": [
            {
              "value": "fixed_1",
              "label": "Fixe, 1 image (défaut)"
            },
            {
              "value": "fastest",
              "label": "Au plus rapide"
            }
          ]
        }
      ]
    },
    {
      "id": "log_level",
      "label": "Niveau de log (à chaud)",
      "endpoint": "/log_level",
      "params": [
        {
          "key": "level",
          "label": "Niveau",
          "type": "text",
          "default": "info",
          "options": [
            {
              "value": "debug",
              "label": "Détaillé"
            },
            {
              "value": "info",
              "label": "Événements (défaut)"
            },
            {
              "value": "warning",
              "label": "Anomalies seules"
            },
            {
              "value": "error",
              "label": "Erreurs seules"
            }
          ]
        }
      ]
    }
  ],
  "param_tree": {
    "boxes": {
      "count_from": "n_boxes",
      "idx": "slot",
      "path_prefix": "boxes",
      "label_from": "consumes"
    },
    "box_groups": [
      {
        "label": "Géométrie",
        "endpoint": "/box",
        "caps": "box_fields",
        "fields": {
          "x": {
            "label": "Position X",
            "type": "position"
          },
          "y": {
            "label": "Position Y",
            "type": "position"
          },
          "size": {
            "label": "Taille",
            "type": "ratio"
          },
          "rotation": {
            "label": "Rotation",
            "type": "angle"
          },
          "opacity": {
            "label": "Opacité",
            "type": "percent"
          },
          "feather": {
            "label": "Adoucissement des bords",
            "type": "pixels"
          },
          "radius": {
            "label": "Coins arrondis",
            "type": "pixels"
          }
        }
      },
      {
        "label": "Affichage",
        "endpoint": "/box",
        "caps": "box_fields",
        "fields": {
          "enabled": {
            "label": "Activée",
            "type": "bool"
          },
          "mirror_h": {
            "label": "Miroir horizontal",
            "type": "bool"
          },
          "mirror_v": {
            "label": "Miroir vertical",
            "type": "bool"
          },
          "aspect": {
            "label": "Ratio",
            "type": "enum",
            "enum_caps": "box_enums"
          }
        }
      },
      {
        "label": "Recadrage (armement)",
        "endpoint": "/box",
        "caps": "box_fields",
        "fields": {
          "crop_enabled": {
            "label": "Rognage armé",
            "type": "bool"
          }
        }
      },
      {
        "label": "Recadrage",
        "endpoint": "/box",
        "wrap": "crop",
        "caps": "crop",
        "fields": {
          "t": {
            "label": "Haut",
            "type": "ratio"
          },
          "b": {
            "label": "Bas",
            "type": "ratio"
          },
          "l": {
            "label": "Gauche",
            "type": "ratio"
          },
          "r": {
            "label": "Droite",
            "type": "ratio"
          }
        }
      },
      {
        "label": "Bordure (armement)",
        "endpoint": "/box",
        "caps": "box_fields",
        "fields": {
          "border_enabled": {
            "label": "Bordure armée",
            "type": "bool"
          }
        }
      },
      {
        "label": "Bordure",
        "endpoint": "/box",
        "wrap": "border",
        "caps": "border_fields",
        "fields": {
          "outer": {
            "label": "Épaisseur extérieure",
            "type": "pixels"
          },
          "inner": {
            "label": "Épaisseur intérieure",
            "type": "pixels"
          },
          "bevel": {
            "label": "Biseau (relief)",
            "type": "ratio"
          },
          "bevel_soft": {
            "label": "Adoucissement du biseau",
            "type": "ratio"
          }
        }
      },
      {
        "label": "Ombre portée",
        "endpoint": "/box",
        "wrap": "shadow",
        "caps": "shadow_fields",
        "fields": {
          "dx": {
            "label": "Décalage X",
            "type": "pixels"
          },
          "dy": {
            "label": "Décalage Y",
            "type": "pixels"
          },
          "blur": {
            "label": "Flou",
            "type": "pixels"
          },
          "opacity": {
            "label": "Opacité",
            "type": "percent"
          }
        }
      }
    ],
    "global_groups": [
      {
        "label": "Groupe (calque global)",
        "endpoint": "/global",
        "caps": "global_fields",
        "path_prefix": "global",
        "fields": {
          "dx": {
            "label": "Décalage X",
            "type": "ratio"
          },
          "dy": {
            "label": "Décalage Y",
            "type": "ratio"
          },
          "scale": {
            "label": "Échelle",
            "type": "scale"
          },
          "rotation": {
            "label": "Rotation",
            "type": "angle"
          },
          "opacity": {
            "label": "Opacité",
            "type": "percent"
          }
        }
      },
      {
        "label": "Lumière",
        "endpoint": "/light",
        "caps": "light_fields",
        "path_prefix": "light",
        "fields": {
          "angle": {
            "label": "Direction",
            "type": "angle"
          },
          "altitude": {
            "label": "Hauteur",
            "type": "angle"
          }
        }
      },
      {
        "label": "Délai",
        "endpoint": "/latency",
        "fields": {
          "mode": {
            "label": "Délai",
            "type": "enum",
            "options": [
              "fixed_1",
              "fastest"
            ],
            "default": "fixed_1",
            "path": "latency_mode"
          }
        }
      },
      {
        "label": "Journal (diagnostic)",
        "endpoint": "/log_level",
        "fields": {
          "level": {
            "label": "Niveau de log",
            "type": "enum",
            "options": [
              "debug",
              "info",
              "warning",
              "error"
            ],
            "default": "info",
            "path": "log_level"
          }
        }
      }
    ]
  },
  "config_schema": [
    {
      "key": "slice_mode",
      "hidden": true,
      "type": "checkbox",
      "label": "Mode tranche (latence sous-image)",
      "help": "La vidéo est publiée bande par bande sur le bus MXL : l'aval démarre sur la première bande sans attendre l'image complète (latence sous-image). Entrelacé ou hauteur non divisible → repli image entière. Désactivé (défaut) = comportement historique. Le fond et chaque box suivent leur grain source.",
      "default": false,
      "scope": "system"
    },
    {
      "key": "slice_lines",
      "hidden": true,
      "type": "number",
      "label": "Lignes par tranche",
      "help": "Hauteur des bandes (lignes). Doit être un diviseur de la hauteur d'image (36 pour 1080p) — sinon repli image entière.",
      "min": 4,
      "max": 540,
      "default": 36,
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      }
    },
    {
      "key": "cadence",
      "hidden": true,
      "type": "select",
      "label": "Cadence de composition",
      "help": "flow : tissu en tranches — chaque couche cible l'index d'epoch de sa source et la sortie est écrite à ce même index (exige le mode tranche éligible, sinon repli pacing historique).",
      "default": "",
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      },
      "options": [
        {
          "value": "",
          "label": "Pacing historique (défaut)"
        },
        {
          "value": "flow",
          "label": "Flow (tissu en tranches)"
        }
      ]
    },
    {
      "key": "transition_curve",
      "type": "select",
      "label_i18n": "split.cfg.curve",
      "help_i18n": "split.cfg.curve_help",
      "default": "ease_in_out",
      "scope": "user",
      "options": [
        {
          "value": "linear",
          "label_i18n": "split.easing.linear"
        },
        {
          "value": "ease_in",
          "label_i18n": "split.easing.ease_in"
        },
        {
          "value": "ease_out",
          "label_i18n": "split.easing.ease_out"
        },
        {
          "value": "ease_in_out",
          "label_i18n": "split.easing.ease_in_out"
        },
        {
          "value": "cubic_in",
          "label_i18n": "split.easing.cubic_in"
        },
        {
          "value": "cubic_out",
          "label_i18n": "split.easing.cubic_out"
        },
        {
          "value": "cubic_in_out",
          "label_i18n": "split.easing.cubic_in_out"
        },
        {
          "value": "sine_in_out",
          "label_i18n": "split.easing.sine_in_out"
        },
        {
          "value": "expo_out",
          "label_i18n": "split.easing.expo_out"
        }
      ]
    },
    {
      "key": "transition_stagger_ms",
      "type": "number",
      "label_i18n": "split.cfg.stagger",
      "help_i18n": "split.cfg.stagger_help",
      "min": 0,
      "max": 2000,
      "default": 0,
      "scope": "user"
    },
    {
      "key": "latency_mode",
      "type": "select",
      "label": "Délai",
      "help": "Fixe, 1 image (défaut) : le split compose toujours l'image du créneau précédent. Le délai est constant, et toutes les sources arrivent à temps, même traitées ou en retard. Au plus rapide : il compose l'image du créneau en cours dès que ses premières lignes arrivent ; une source en retard passe avec sa dernière image, et c'est compté. Réglable à chaud.",
      "options": [
        {
          "value": "fixed_1",
          "label": "Fixe, 1 image (défaut)"
        },
        {
          "value": "fastest",
          "label": "Au plus rapide"
        }
      ],
      "default": "fixed_1",
      "scope": "system",
      "live": {
        "endpoint": "/latency",
        "key": "mode"
      }
    },
    {
      "key": "log_level",
      "type": "select",
      "label": "Niveau de log",
      "help": "Verbosité du journal du conteneur. Défaut « Événements » : les faits marquants (démarrage/arrêt, changement de format, reconnexion, repli sur un chemin dégradé, entrée qui apparaît ou disparaît) sont TOUJOURS écrits — après une panne le journal doit permettre de reconstituer l'histoire, et élever le niveau après coup ne récupère rien. Les métriques périodiques (fps, compteurs) ne sont PAS journalisées : elles sont déjà publiées sur :8080. « Détaillé » = lance-flammes par trame, à n'activer que le temps d'un diagnostic (le journal Docker n'est pas roté).",
      "options": [
        {
          "value": "debug",
          "label": "Détaillé (par trame — diagnostic ponctuel)"
        },
        {
          "value": "info",
          "label": "Événements (défaut)"
        },
        {
          "value": "warning",
          "label": "Anomalies seules"
        },
        {
          "value": "error",
          "label": "Erreurs seules"
        }
      ],
      "default": "info",
      "scope": "user"
    }
  ],
  "resources": {
    "cores": 3,
    "memory": 2048,
    "pin": true,
    "gpu_optional": 1,
    "gpu_instance": {
      "param": "render",
      "values": [
        "gpu",
        "auto"
      ]
    },
    "regime": "rafale",
    "signature_keys": [
      "width",
      "height",
      "fps",
      "scan",
      "render",
      "genlock",
      "align_budget",
      "box_config",
      "art",
      "transition"
    ]
  }
}