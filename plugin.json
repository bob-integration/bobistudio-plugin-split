{
  "license": "GPL-3.0-or-later",
  "type": "dve",
  "runtime": "docker",
  "atem_role": "dve",
  "label": "DVE",
  "badge": {
    "label": "DVE",
    "class": "mode-dve"
  },
  "version": "0.5.0",
  "description": "SuperSource : 4 PiP (position/taille/crop) composités sur 1 fond → 1 sortie. Géométrie + mémoires/transitions pilotées en live. (v0.2.0 : marqueur `variant` exposé sur :8080 pour tester le multi-versions.)",
  "nav": {
    "section": "traitements",
    "label": "Traitements",
    "route": "/traitements/dve",
    "order": 40
  },
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "deploy_defaults": {
    "width": 1280,
    "height": 720,
    "fps": 25,
    "scan": "p",
    "genlock": true,
    "align_budget": 1,
    "box_config": [
      {
        "x": 0.28,
        "y": 0.3,
        "size": 0.42
      },
      {
        "x": 0.72,
        "y": 0.3,
        "size": 0.42
      },
      {
        "x": 0.28,
        "y": 0.7,
        "size": 0.42
      },
      {
        "x": 0.72,
        "y": 0.7,
        "size": 0.42
      }
    ],
    "input_0": null,
    "input_1": null,
    "input_2": null,
    "input_3": null,
    "bg_input": null
  },
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{hostname}_dve"
      }
    ],
    "consumes": [
      {
        "essence": "video",
        "slot": 0,
        "state_field": "input_0",
        "label": "Box 1"
      },
      {
        "essence": "video",
        "slot": 1,
        "state_field": "input_1",
        "label": "Box 2"
      },
      {
        "essence": "video",
        "slot": 2,
        "state_field": "input_2",
        "label": "Box 3"
      },
      {
        "essence": "video",
        "slot": 3,
        "state_field": "input_3",
        "label": "Box 4"
      },
      {
        "essence": "video",
        "slot": 4,
        "state_field": "bg_input",
        "label": "Fond"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/state"
  },
  "control": {
    "port": 8082,
    "endpoints": [
      "/state",
      "/input",
      "/box",
      "/recall"
    ],
    "atem": {
      "CSBP": "/box"
    },
    "recall": {
      "source": "plugin_store",
      "scope": "container",
      "endpoint": "/recall"
    }
  },
  "store": {
    "scope": "container"
  }
}
