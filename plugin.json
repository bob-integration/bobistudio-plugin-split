{
  "license": "GPL-3.0-or-later",
  "type": "split",
  "runtime": "docker",
  "atem_role": "dve",
  "label": "Split",
  "badge": {
    "label": "Split",
    "class": "mode-split",
    "oklch": "0.80 0.06 200"
  },
  "reference_slot": 4,
  "skaarhoj": {
    "mode": "split",
    "desc_i18n": "settings.js.skh_desc_split"
  },
  "version": "0.11.1",
  "description": "Composite 4 incrustations (PiP) sur un fond → 1 sortie, + couche ART (habillage importé, incrustation luma/chroma/alpha, au-dessus ou en dessous). Mode avancé par box : rotation, opacité, adoucissement des bords, coins arrondis, ombre portée, miroir, ratio libre, z-ordre libre, bordure 3D (biseau + source de lumière). Transitions à courbes d'accélération, décalage inter-boxes, tous les paramètres interpolés. Réglages avancés neutres par défaut → chemin de composition historique inchangé.",
  "nav": {
    "section": "traitements",
    "label": "Traitements",
    "route": "/traitements/split",
    "order": 40
  },
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "deploy_defaults": {
    "width": 1280,
    "height": 720,
    "fps": 25,
    "scan": "p",
    "genlock": true,
    "align_budget": 1,
    "box_config": [
      {
        "x": 0.28,
        "y": 0.3,
        "size": 0.42
      },
      {
        "x": 0.72,
        "y": 0.3,
        "size": 0.42
      },
      {
        "x": 0.28,
        "y": 0.7,
        "size": 0.42
      },
      {
        "x": 0.72,
        "y": 0.7,
        "size": 0.42
      }
    ],
    "input_0": null,
    "input_1": null,
    "input_2": null,
    "input_3": null,
    "bg_input": null,
    "light": {
      "angle": 36.0,
      "altitude": 25.0
    },
    "transition": {
      "curve": "ease_in_out",
      "stagger_ms": 0
    },
    "art": {
      "enabled": false,
      "above": true,
      "image": "",
      "key": "alpha",
      "clip": 0.0,
      "gain": 1.0,
      "invert": false,
      "opacity": 1.0,
      "chroma_key": "#00b140"
    }
  },
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{hostname}_split"
      }
    ],
    "consumes": [
      {
        "essence": "video",
        "slot": 0,
        "state_field": "input_0",
        "label": "Box 1"
      },
      {
        "essence": "video",
        "slot": 1,
        "state_field": "input_1",
        "label": "Box 2"
      },
      {
        "essence": "video",
        "slot": 2,
        "state_field": "input_2",
        "label": "Box 3"
      },
      {
        "essence": "video",
        "slot": 3,
        "state_field": "input_3",
        "label": "Box 4"
      },
      {
        "essence": "video",
        "slot": 4,
        "state_field": "bg_input",
        "label": "Fond"
      }
    ],
    "mode": "hot-wire",
    "state_endpoint": "/state"
  },
  "control": {
    "port": 8082,
    "endpoints": [
      "/state",
      "/input",
      "/box",
      "/recall",
      "/art",
      "/light",
      "/transition"
    ],
    "atem": {
      "CSBP": "/box"
    },
    "recall": {
      "source": "plugin_store",
      "scope": "container",
      "endpoint": "/recall"
    },
    "read_endpoints": [
      "/state"
    ]
  },
  "store": {
    "scope": "container"
  },
  "actions": [
    {
      "id": "recall_memory",
      "label": "Rappeler une mémoire",
      "core": "recall",
      "params": [
        {
          "key": "memory",
          "label": "Mémoire",
          "type": "number",
          "options_from": "recall"
        },
        {
          "key": "duration_ms",
          "label": "Transition (ms, 0 = cut)",
          "type": "number",
          "default": 0
        }
      ]
    }
  ],
  "config_schema": [
    {
      "key": "slice_mode",
      "hidden": true,
      "type": "checkbox",
      "label": "Mode tranche (latence sous-image)",
      "help": "La vidéo est publiée bande par bande sur le bus MXL : l'aval démarre sur la première bande sans attendre l'image complète (latence sous-image). Entrelacé ou hauteur non divisible → repli image entière. Désactivé (défaut) = comportement historique. Le fond et chaque box suivent leur grain source.",
      "default": false,
      "scope": "system"
    },
    {
      "key": "slice_lines",
      "hidden": true,
      "type": "number",
      "label": "Lignes par tranche",
      "help": "Hauteur des bandes (lignes). Doit être un diviseur de la hauteur d'image (36 pour 1080p) — sinon repli image entière.",
      "min": 4,
      "max": 540,
      "default": 36,
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      }
    },
    {
      "key": "cadence",
      "hidden": true,
      "type": "select",
      "label": "Cadence de composition",
      "help": "flow : tissu en tranches — chaque couche cible l'index d'epoch de sa source et la sortie est écrite à ce même index (exige le mode tranche éligible, sinon repli pacing historique).",
      "default": "",
      "scope": "system",
      "visible_if": {
        "slice_mode": true
      },
      "options": [
        {
          "value": "",
          "label": "Pacing historique (défaut)"
        },
        {
          "value": "flow",
          "label": "Flow (tissu en tranches)"
        }
      ]
    },
    {
      "key": "light_angle",
      "type": "number",
      "label_i18n": "split.cfg.light_angle",
      "help_i18n": "split.cfg.light_angle_help",
      "min": 0,
      "max": 360,
      "default": 36,
      "scope": "system"
    },
    {
      "key": "light_altitude",
      "type": "number",
      "label_i18n": "split.cfg.light_altitude",
      "help_i18n": "split.cfg.light_altitude_help",
      "min": 0,
      "max": 90,
      "default": 25,
      "scope": "system"
    },
    {
      "key": "transition_curve",
      "type": "select",
      "label_i18n": "split.cfg.curve",
      "help_i18n": "split.cfg.curve_help",
      "default": "ease_in_out",
      "scope": "user",
      "options": [
        {
          "value": "linear",
          "label_i18n": "split.easing.linear"
        },
        {
          "value": "ease_in",
          "label_i18n": "split.easing.ease_in"
        },
        {
          "value": "ease_out",
          "label_i18n": "split.easing.ease_out"
        },
        {
          "value": "ease_in_out",
          "label_i18n": "split.easing.ease_in_out"
        },
        {
          "value": "cubic_in",
          "label_i18n": "split.easing.cubic_in"
        },
        {
          "value": "cubic_out",
          "label_i18n": "split.easing.cubic_out"
        },
        {
          "value": "cubic_in_out",
          "label_i18n": "split.easing.cubic_in_out"
        },
        {
          "value": "sine_in_out",
          "label_i18n": "split.easing.sine_in_out"
        },
        {
          "value": "expo_out",
          "label_i18n": "split.easing.expo_out"
        }
      ]
    },
    {
      "key": "transition_stagger_ms",
      "type": "number",
      "label_i18n": "split.cfg.stagger",
      "help_i18n": "split.cfg.stagger_help",
      "min": 0,
      "max": 2000,
      "default": 0,
      "scope": "user"
    }
  ]
}